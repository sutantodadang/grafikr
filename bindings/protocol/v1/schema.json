      "allOf":[
        {"if":{"properties":{"op":{"const":"hello"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["protocol_major","protocol_minor","sdk_version"],"properties":{"protocol_major":{"const":1},"protocol_minor":{"type":"integer","minimum":0},"sdk_version":{"type":"string","minLength":1}}}}}},
        {"if":{"properties":{"op":{"const":"shutdown"}}},"then":{"properties":{"args":{"maxProperties":0}}}},
        {"if":{"properties":{"op":{"const":"window.create"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["title","width","height"],"properties":{"title":{"type":"string"},"width":{"$ref":"#/$defs/positive"},"height":{"$ref":"#/$defs/positive"},"theme":{"enum":["dark","light"]},"reduced_motion":{"type":"boolean"}}}}}},
        {"if":{"properties":{"op":{"const":"window.update"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["window"],"minProperties":2,"properties":{"window":{"$ref":"#/$defs/token"},"title":{"type":"string"},"width":{"$ref":"#/$defs/positive"},"height":{"$ref":"#/$defs/positive"},"theme":{"enum":["dark","light"]},"reduced_motion":{"type":"boolean"}}}}}},
        {"if":{"properties":{"op":{"const":"window.close"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["window"],"properties":{"window":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"node.create"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["window","widget","properties"],"properties":{"window":{"$ref":"#/$defs/token"},"widget":{"enum":["Column","Row","Grid","Stack","Text","Button","TextField","Checkbox","Radio","Switch","Slider","ProgressBar","Spinner","ScrollView","VirtualList","DataGrid","TreeView","Modal","Popup","Tabs","ComboBox","Tooltip","Image","Canvas"]},"properties":{"type":"object"}}}}}},
        {"if":{"properties":{"op":{"const":"node.attach"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","parent"],"properties":{"node":{"$ref":"#/$defs/token"},"parent":{"$ref":"#/$defs/token"},"index":{"type":"integer","minimum":0}}}}}},
        {"if":{"properties":{"op":{"enum":["node.detach","node.destroy"]}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node"],"properties":{"node":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"node.replace_children"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","children"],"properties":{"node":{"$ref":"#/$defs/token"},"children":{"type":"array","items":{"$ref":"#/$defs/token"},"maxItems":100000}}}}}},
        {"if":{"properties":{"op":{"const":"property.update"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","properties"],"properties":{"node":{"$ref":"#/$defs/token"},"properties":{"type":"object"}}}}}},
        {"if":{"properties":{"op":{"const":"state.create"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{"$ref":"#/$defs/scalar"}}}}}},
        {"if":{"properties":{"op":{"enum":["state.get","state.destroy"]}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["state"],"properties":{"state":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"state.set"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["state","value"],"properties":{"state":{"$ref":"#/$defs/token"},"value":{"$ref":"#/$defs/scalar"}}}}}},
        {"if":{"properties":{"op":{"const":"binding.bind"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["state","node","property","direction"],"properties":{"state":{"$ref":"#/$defs/token"},"node":{"$ref":"#/$defs/token"},"property":{"type":"string","minLength":1},"direction":{"enum":["one_way","two_way"]}}}}}},
        {"if":{"properties":{"op":{"const":"binding.unbind"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["binding"],"properties":{"binding":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"event.subscribe"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","event"],"properties":{"node":{"$ref":"#/$defs/token"},"event":{"enum":["click","change","select","resize","data.request"]}}}}}},
        {"if":{"properties":{"op":{"const":"event.unsubscribe"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["subscription"],"properties":{"subscription":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"image.begin"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["width","height","byte_length"],"properties":{"width":{"type":"integer","minimum":1,"maximum":8192},"height":{"type":"integer","minimum":1,"maximum":8192},"byte_length":{"type":"integer","minimum":4}}}}}},
        {"if":{"properties":{"op":{"const":"image.chunk"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["upload","offset","data"],"properties":{"upload":{"$ref":"#/$defs/token"},"offset":{"type":"integer","minimum":0},"data":{"type":"string","contentEncoding":"base64"}}}}}},
        {"if":{"properties":{"op":{"const":"image.finalize"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["upload"],"properties":{"upload":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"image.destroy"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["image"],"properties":{"image":{"$ref":"#/$defs/token"}}}}}},
        {"if":{"properties":{"op":{"const":"canvas.update"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","commands"],"properties":{"node":{"$ref":"#/$defs/token"},"commands":{"type":"array","maxItems":10000,"items":{"type":"object"}}}}}}},
        {"if":{"properties":{"op":{"const":"collection.create"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","row_count","row_height","columns"],"properties":{"node":{"$ref":"#/$defs/token"},"row_count":{"type":"integer","minimum":0},"row_height":{"$ref":"#/$defs/positive"},"columns":{"type":"array","items":{"type":"string"}}}}}}},
        {"if":{"properties":{"op":{"const":"collection.update"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","metadata"],"properties":{"node":{"$ref":"#/$defs/token"},"metadata":{"type":"object","additionalProperties":false,"required":["row_count","row_height","columns"],"properties":{"row_count":{"type":"integer","minimum":0},"row_height":{"$ref":"#/$defs/positive"},"columns":{"type":"array","items":{"type":"string"}}}}}}}}},
        {"if":{"properties":{"op":{"const":"data.provide"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["node","revision","request","start","rows"],"properties":{"node":{"$ref":"#/$defs/token"},"revision":{"$ref":"#/$defs/token"},"request":{"type":"string"},"start":{"type":"integer","minimum":0},"rows":{"type":"array","items":{"type":"array"}}}}}}},
        {"if":{"properties":{"op":{"const":"transition.start"}}},"then":{"properties":{"args":{"type":"object","additionalProperties":false,"required":["state","to","duration_ms","easing"],"properties":{"state":{"$ref":"#/$defs/token"},"to":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"f64"},"value":{"type":"number","maximum":3.4028234663852886e38,"minimum":-3.4028234663852886e38}}},"duration_ms":{"type":"integer","minimum":0,"maximum":4294967295},"easing":{"enum":["linear","ease_out_cubic","ease_in_out_cubic"]}}}}}}
      ]
    },
    "response":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","id","ok","result"],"properties":{"kind":{"const":"response"},"id":{"type":"string"},"ok":{"const":true},"result":{}}},{"type":"object","additionalProperties":false,"required":["kind","id","ok","error"],"properties":{"kind":{"const":"response"},"id":{"type":"string"},"ok":{"const":false},"error":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"field":{"type":"string"},"handle":{"$ref":"#/$defs/token"}}}}}]},
    "event":{"type":"object","additionalProperties":false,"required":["kind","sequence","event","source","payload"],"properties":{"kind":{"const":"event"},"sequence":{"$ref":"#/$defs/token"},"event":{"type":"string"},"source":{"$ref":"#/$defs/token"},"payload":{"type":"object"}}},
    "wire_message":{"oneOf":[{"$ref":"#/$defs/request"},{"$ref":"#/$defs/response"},{"$ref":"#/$defs/event"}]}
  },
  "$ref":"#/$defs/request"
}

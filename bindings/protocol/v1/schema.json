  "title": "Grafikr Protocol 1.0",
  "description": "Normative UTF-8 JSON Lines request, response, and event shapes. Runtime also enforces byte, nesting, lifecycle, handle-kind, and quota constraints.",
  "$defs": {
    "token": {"type":"string","pattern":"^(0|[1-9][0-9]*)$","maxLength":20},
    "i64": {"type":"string","pattern":"^(0|-?[1-9][0-9]*)$","maxLength":20},
    "positive": {"type":"number","exclusiveMinimum":0},
    "scalar": {"oneOf":[{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"bool"},"value":{"type":"boolean"}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"i64"},"value":{"$ref":"#/$defs/i64"}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"f64"},"value":{"type":"number"}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"string"},"value":{"type":"string"}}}]},
    "request": {

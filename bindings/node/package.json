    "@grafikr/runtime-linux-arm64": "1.1.0",
    "@grafikr/runtime-darwin-x64": "1.1.0",
    "@grafikr/runtime-darwin-arm64": "1.1.0"
  },
  "devDependencies": {"@types/node": "^24.0.0", "typescript": "~5.8.3"},

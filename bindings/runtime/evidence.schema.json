{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafikr.dev/runtime/evidence-v1.schema.json",
  "title": "Grafikr implementation and runtime evidence v1",
  "type": "object",
  "required": [
    "stage", "sdk", "consumer_language", "engine_version", "sdk_version",
    "protocol_version", "runtime_version", "target", "backend", "gpu_kind",
    "gpu_vendor", "source_sha", "runner_sha", "artifact_sha256", "command",
    "exit_code", "status", "started_at", "finished_at", "attachments", "reason"
  ],
  "properties": {
    "stage": {"enum": ["build", "unit", "contract", "installed", "gui", "hardware", "benchmark", "publication"]},
    "scenario": {"type": "string", "minLength": 1},
    "display_cell": {"type": "string", "minLength": 1},
    "input_method": {"enum": ["windows_sendinput", "xdotool", "osascript", "manual_supervised"]},
    "sdk": {"type": "string", "minLength": 1},
    "consumer_language": {"type": "string", "minLength": 1},
    "engine_version": {"type": ["string", "null"]},
    "sdk_version": {"type": ["string", "null"]},
    "protocol_version": {"type": "object", "additionalProperties": false, "required": ["major", "minor"], "properties": {"major": {"type": "integer", "minimum": 1}, "minor": {"type": "integer", "minimum": 0}}},
    "runtime_version": {"type": ["string", "null"]},
    "target": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "gpu_kind": {"type": ["string", "null"]},
    "gpu_vendor": {"type": ["string", "null"]},
    "source_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "runner_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "exit_code": {"type": ["integer", "null"]},
    "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"exit_code": {"const": 0}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "target": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"status": {"const": "UNVERIFIED"}}, "required": ["status"]}, "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"stage": {"const": "gui"}}, "required": ["stage"]}, "then": {"required": ["scenario", "display_cell", "input_method"]}},
    {"if": {"properties": {"stage": {"const": "hardware"}}, "required": ["stage"]}, "then": {"required": ["display_cell"]}},
    {"if": {"properties": {"stage": {"const": "benchmark"}}, "required": ["stage"]}, "then": {"required": ["display_cell", "native_endpoint", "ipc_endpoint", "sample_count", "benchmark_workloads"], "properties": {"native_endpoint": {"const": "request_to_response"}, "ipc_endpoint": {"const": "request_to_response"}, "sample_count": {"type": "integer", "minimum": 1000}, "benchmark_workloads": {"type": "array", "minItems": 1, "uniqueItems": true}, "attachments": {"minItems": 1}}}}
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv"],
      "properties": {"name": {"type": "string", "minLength": 1}, "argv": {"type": "array", "items": {"type": "string"}}}
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "kind": {"enum": ["screenshot", "client_state", "gpu_report", "accessibility_report", "benchmark_samples", "package"]}}
    }
  }
}

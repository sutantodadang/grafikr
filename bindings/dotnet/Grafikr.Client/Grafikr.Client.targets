<Project>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(RuntimeIdentifier)\native\**\*" Exclude="$(MSBuildThisFileDirectory)..\runtimes\$(RuntimeIdentifier)\native\LICENSE">
      <TargetPath>runtimes/$(RuntimeIdentifier)/native/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(RuntimeIdentifier)\native\LICENSE">
      <TargetPath>runtimes/$(RuntimeIdentifier)/native/LICENSE</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
